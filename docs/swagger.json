{
    "swagger": "2.0",
    "info": {
        "description": "Modern REST API for Go-PostfixAdmin with JWT authentication.",
        "title": "Go-PostfixAdmin API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
